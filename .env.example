# Copy to .env and adjust. Never commit .env.
DATABASE_URL="postgresql://caresync:caresync_dev_only@localhost:5433/caresync"
APP_URL="http://localhost:3000"
# Reserved for HMAC of tokens. Generate: openssl rand -hex 32
APP_SECRET="replace-with-32-plus-random-bytes-hex"
# Protects POST /api/cron/reminders (Authorization: Bearer <value>)
CRON_SECRET="replace-with-random-string"
# Optional SMTP; if unset, emails are written to the server console (dev fallback)
SMTP_URL=""
MAIL_FROM="CareSync <no-reply@example.invalid>"
# Enables /demo synthetic accounts. Keep "false" in production.
DEMO_MODE="true"

# Optional public footer details (shown only when set)
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_GITHUB_URL=""
# Local port for the e2e server (Playwright)
E2E_PORT="4317"
